# OpenFraud Investigator — example environment. Copy to `.env` at the repo root and fill in.
# Placeholders only; never commit real values. `.env` is git-ignored.

# ---- Backend (services/api) ----
OFI_APP_ENV=local
# Interactive API docs at /docs. Off unless set; enable only for local development.
OFI_DOCS_ENABLED=true
# Generate with: openssl rand -hex 32   (minimum 32 characters)
OFI_JWT_SECRET=<JWT_SECRET>
OFI_DATABASE_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@localhost:5433/openfraud
# Used only by the test suite; database name must end in _test.
OFI_TEST_DATABASE_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@localhost:5433/openfraud_test
# Password given to the seeded demo users (min 12 characters). Synthetic demo only.
OFI_DEMO_PASSWORD=<DEMO_PASSWORD>

# ---- Local PostgreSQL (docker compose) ----
OFI_DB_USER=<DB_USER>
OFI_DB_PASSWORD=<DB_PASSWORD>
OFI_DB_NAME=openfraud

# ---- Used from Milestone 5 (AI copilot). Never commit a real key. ----
# OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
# OPENROUTER_MODEL=<OPEN_WEIGHT_MODEL_ID>
